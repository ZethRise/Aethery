<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_panel">

    <ImageView
        android:id="@+id/sky"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/connect"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:contentDescription="@string/widget_connect"
                android:scaleType="fitCenter" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/manrope"
                    android:fontVariationSettings="'wght' 650"
                    android:maxLines="1"
                    android:text="@string/vpn_disconnected"
                    android:textColor="#F2EEFF"
                    android:textSize="19sp" />

                <TextView
                    android:id="@+id/method"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/widget_chip"
                    android:contentDescription="@string/widget_method"
                    android:ellipsize="end"
                    android:fontFamily="@font/manrope"
                    android:fontVariationSettings="'wght' 600"
                    android:maxLines="1"
                    android:paddingLeft="10dp"
                    android:paddingTop="5dp"
                    android:paddingRight="10dp"
                    android:paddingBottom="5dp"
                    android:text="@string/widget_method_masque"
                    android:textColor="#F2EEFF"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/ip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/widget_chip"
            android:ellipsize="end"
            android:fontFamily="@font/manrope"
            android:fontVariationSettings="'wght' 600"
            android:gravity="center"
            android:maxLines="1"
            android:paddingLeft="10dp"
            android:paddingTop="11dp"
            android:paddingRight="10dp"
            android:paddingBottom="11dp"
            android:text="@string/widget_ip_idle"
            android:textColor="#F2EEFF"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/speed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/widget_chip"
            android:fontFamily="@font/manrope"
            android:fontVariationSettings="'wght' 600"
            android:gravity="center"
            android:paddingLeft="10dp"
            android:paddingTop="11dp"
            android:paddingRight="10dp"
            android:paddingBottom="11dp"
            android:text="@string/widget_speed_idle"
            android:textColor="#F2EEFF"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/masque_heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="14dp"
            android:fontFamily="@font/manrope"
            android:fontVariationSettings="'wght' 600"
            android:text="@string/widget_masque_heading"
            android:textColor="#A9A7C9"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/h3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/widget_chip_on"
                android:contentDescription="@string/widget_h3"
                android:fontFamily="@font/manrope"
                android:fontVariationSettings="'wght' 600"
                android:gravity="center"
                android:paddingTop="9dp"
                android:paddingBottom="9dp"
                android:text="@string/widget_h3"
                android:textColor="#9DB0FF"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/h2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="@drawable/widget_chip"
                android:contentDescription="@string/widget_h2"
                android:fontFamily="@font/manrope"
                android:fontVariationSettings="'wght' 600"
                android:gravity="center"
                android:paddingTop="9dp"
                android:paddingBottom="9dp"
                android:text="@string/widget_h2"
                android:textColor="#F2EEFF"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/fallback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/widget_chip"
            android:contentDescription="@string/widget_fallback"
            android:fontFamily="@font/manrope"
            android:fontVariationSettings="'wght' 600"
            android:gravity="center"
            android:paddingTop="9dp"
            android:paddingBottom="9dp"
            android:text="@string/widget_fallback_on"
            android:textColor="#F2EEFF"
            android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>

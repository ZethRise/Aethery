<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_panel">

    <ImageView
        android:id="@+id/sky"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="10dp">

        <ImageView
            android:id="@+id/connect"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:contentDescription="@string/widget_connect"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:fontFamily="@font/manrope"
            android:fontVariationSettings="'wght' 650"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/vpn_disconnected"
            android:textColor="#F2EEFF"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/method"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/widget_chip"
            android:contentDescription="@string/widget_method"
            android:ellipsize="end"
            android:fontFamily="@font/manrope"
            android:fontVariationSettings="'wght' 600"
            android:gravity="center"
            android:maxLines="1"
            android:paddingLeft="8dp"
            android:paddingTop="5dp"
            android:paddingRight="8dp"
            android:paddingBottom="5dp"
            android:text="@string/widget_method_masque"
            android:textColor="#F2EEFF"
            android:textSize="11sp" />
    </LinearLayout>
</FrameLayout>

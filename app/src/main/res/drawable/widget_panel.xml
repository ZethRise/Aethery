<?xml version="1.0" encoding="utf-8"?>
<!-- The Halo sky: dusk at the bottom, midnight above. The live widgets draw their own sky over this,
     so a theme other than Halo shows its own colours; this is what the widget picker previews. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:endColor="#1B1A45"
        android:startColor="#0B0D24" />
    <corners android:radius="24dp" />
    <stroke
        android:width="1dp"
        android:color="#1AF2EEFF" />
</shape>
